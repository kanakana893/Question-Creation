---
config:
  layout: elk
---
erDiagram
    direction LR

    %% --- エンティティ定義 ---
    users {
        int user_id PK
        string username
        string email
        string password_hash
        datetime created_at
    }

    tests {
        int test_id PK
        int user_id FK
        string title
        string description
        int total_questions
        int total_score
        datetime created_at
    }

    questions {
        int question_id PK
        int test_id FK
        string question_type
        string question_text
        int points
        int correct_choice_id FK
        string explanation
    }

    choices {
        int choice_id PK
        int question_id FK
        int choice_number
        string choice_text
    }

    test_results {
        int result_id PK
        int user_id FK
        int test_id FK
        int score
        boolean passed
        datetime attempted_at
    }

    user_answer_details {
        int detail_id PK
        int result_id FK
        int question_id FK
        int selected_choice_id FK
        boolean is_correct
    }

    %% --- テスト作成・定義フロー（左→中央） ---
    users ||--o{ tests : "作成"
    tests ||--o{ questions : "包含"
    questions ||--o{ choices : "持つ"

    %% --- テスト受験・解答フロー（中央→右） ---
    users ||--o{ test_results : "受験"
    tests ||--o{ test_results : "対象"
    test_results ||--|{ user_answer_details : "詳細記録"
    questions ||--o{ user_answer_details : "評価"
    choices ||--o{ user_answer_details : "選択"
